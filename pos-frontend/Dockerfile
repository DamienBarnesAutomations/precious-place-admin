# Stage 1: Build
FROM node:20-alpine AS build-stage
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Declare each ARG so Vite can see them during build
ARG VITE_API_BASE_URL
ARG VITE_IMAGE_BASE_URL
ARG VITE_GET_PRODUCTS_WEBHOOK
ARG VITE_RECORD_SALES_WEBHOOK
ARG VITE_DAILY_SALES_WEBHOOK
ARG VITE_APP_TITLE
ARG VITE_APP_ICON
ARG VITE_LOGO
ARG VITE_CURRENCY
ARG VITE_CREATE_ADMIN_USER_URL
ARG VITE_CREATE_CHAT_ADMIN_USER_URL

# Map ARG to ENV
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_IMAGE_BASE_URL=$VITE_IMAGE_BASE_URL
ENV VITE_GET_PRODUCTS_WEBHOOK=$VITE_GET_PRODUCTS_WEBHOOK
ENV VITE_RECORD_SALES_WEBHOOK=$VITE_RECORD_SALES_WEBHOOK
ENV VITE_DAILY_SALES_WEBHOOK=$VITE_DAILY_SALES_WEBHOOK
ENV VITE_APP_TITLE=$VITE_APP_TITLE
ENV VITE_APP_ICON=$VITE_APP_ICON
ENV VITE_LOGO=$VITE_LOGO
ENV VITE_CURRENCY=$VITE_CURRENCY
ENV VITE_CREATE_ADMIN_USER_URL=$VITE_CREATE_ADMIN_USER_URL
ENV VITE_CREATE_CHAT_ADMIN_USER_URL=$VITE_CREATE_CHAT_ADMIN_USER_URL

RUN npm run build


# Stage 2: Serve
FROM nginx:alpine
COPY --from=build-stage /app/dist /usr/share/nginx/html/pos
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
