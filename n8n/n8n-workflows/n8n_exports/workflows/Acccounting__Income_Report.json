                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "SELECT \n    je.entry_date AS created_at,\n    ac.label AS category,\n    je.description,\n    jl.credit AS amount,\n    je.reference\nFROM journal_lines jl\nJOIN journal_entries je ON jl.journal_entry_id = je.id\nJOIN accounts a ON jl.account_id = a.id\nJOIN account_categories ac ON a.category_id = ac.id\nWHERE a.type = \u0027income\u0027 \n  AND jl.credit \u003e 0\nORDER BY je.entry_date DESC, jl.created_at DESC;\n",
