                  {
                      "parameters":  {
                                         "jsCode":  "const { code, name, type, normal_balance, category_id } = $input.first().json.body;\n\nif (!code || !name || !type || !normal_balance|| !category_id) {\n  throw new Error(\u0027Missing required fields\u0027);\n}\n\nconst validTypes = [\u0027asset\u0027,\u0027liability\u0027,\u0027equity\u0027,\u0027income\u0027,\u0027expense\u0027];\nconst validBalances = [\u0027debit\u0027,\u0027credit\u0027];\n\nif (!validTypes.includes(type)) {\n  throw new Error(\u0027Invalid account type\u0027);\n}\n\nif (!validBalances.includes(normal_balance)) {\n  throw new Error(\u0027Invalid normal balance\u0027);\n}\n\n// Optional: enforce accounting logic server-side\nif ([\u0027asset\u0027,\u0027expense\u0027].includes(type) \u0026\u0026 normal_balance !== \u0027debit\u0027) {\n  throw new Error(\u0027Assets and expenses must have debit normal balance\u0027);\n}\n\nif ([\u0027liability\u0027,\u0027equity\u0027,\u0027income\u0027].includes(type) \u0026\u0026 normal_balance !== \u0027credit\u0027) {\n  throw new Error(\u0027Liabilities, equity, and income must have credit normal balance\u0027);\n}\n\nreturn [{\n  code: code.trim(),\n  name: name.trim(),\n  type,\n  normal_balance, \n  category_id\n}];"
                                     },
