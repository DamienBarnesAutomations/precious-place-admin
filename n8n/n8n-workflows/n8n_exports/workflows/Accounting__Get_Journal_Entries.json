        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT\n  je.id,\n  je.entry_date,\n  je.reference,\n  je.description,\n  SUM(jl.debit) AS total_debit,\n  SUM(jl.credit) AS total_credit\nFROM journal_entries je\nJOIN journal_lines jl ON jl.journal_entry_id = je.id\nGROUP BY je.id\nORDER BY je.entry_date DESC;",
                "options": {}
            },
