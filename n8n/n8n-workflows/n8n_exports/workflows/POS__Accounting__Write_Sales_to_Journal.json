        {
            "parameters": {
                "operation": "executeQuery",
                "query": "WITH next_event AS (\n    -- 1. Find the absolute next timestamp to process\n    SELECT MIN(created_at) as start_ts\n    FROM sales\n    WHERE created_at > COALESCE(\n        (SELECT MAX(last_write) FROM journal_write_log), \n        '1900-01-01'::timestamp\n    )\n),\ndaily_data AS (\n    -- 2. Grab all sales from that timestamp until the end of its specific day\n    SELECT \n        s.total_price,\n        s.quantity,\n        s.transaction_id,\n        (ne.start_ts)::DATE as day_label,\n        s.created_at\n    FROM sales s\n    JOIN next_event ne ON s.created_at >= ne.start_ts\n    WHERE s.created_at < (DATE_TRUNC('day', ne.start_ts) + INTERVAL '1 day')\n)\n-- 3. Aggregate into your requested JSON format\nSELECT json_build_object(\n    'sales_date', day_label,\n    'total_revenue', SUM(total_price),\n    'total_items_sold', SUM(quantity),\n    'total_transactions', COUNT(DISTINCT transaction_id),\n    'source', 'POS_TERMINAL',\n    'next_timestamp', MAX(created_at)\n) AS day_totals\nFROM daily_data\nGROUP BY day_label;\n",
                "options": {}
            },
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.6,
            "position": [
                -160,
                -192
            ],
            "id": "e178ac8f-d396-4f51-b9ad-a15322653d38",
            "name": "Execute a SQL query",
            "credentials": {
                "postgres": {
                    "id": "LleDUwLucS7vZHjv",
                    "name": "POS DB Credentials"
                }
            }
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT json_object_agg('code_' || code, id) AS accounts\nFROM accounts\nWHERE code IN ('1000', '4000');\n",
                "options": {}
            },
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.6,
            "position": [
                288,
                -192
            ],
            "id": "3f2ed273-c03f-441b-893b-547efb9bba6a",
            "name": "Execute a SQL query1",
            "credentials": {
                "postgres": {
                    "id": "tdeYwbyCFeBuflzs",
                    "name": "Accounting Db Credentials"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const accounts = $input.first().json.accounts;\nconst day_totals = $('Execute a SQL query').first().json.day_totals;\n\nconst amount = day_totals.total_revenue;\nconst date = day_totals.sales_date; // e.g., \"2026-02-08\"\nconst items = day_totals.total_items_sold;\nconst txns = day_totals.total_transactions;\n\nconst cash_account_id = accounts.code_1000;\nconst sales_account_id = accounts.code_4000;\n\n// Description with volume context\nconst description = `Sold: $${Number(amount).toLocaleString()} from ${items} items across ${txns} transactions.`;\n\n/** * Build reference using the sales_date.\n * We sanitize the date and add a mini-timestamp suffix \n * to keep it unique if the process runs multiple times.\n */\nconst datePart = date.replace(/-/g, ''); // \"20260208\"\nconst timePart = new Date().toLocaleTimeString('en-GB', { hour12: false }).replace(/:/g, '').slice(0, 4); \nconst reference = `POS-${datePart}-${timePart}`;\n\nreturn [\n  {\n    json: {\n      date: date,\n      description: description,\n      reference: reference,\n      lines: [\n        {\n          account_id: cash_account_id,\n          debit: amount,\n          credit: 0\n        },\n        {\n          account_id: sales_account_id,\n          debit: 0,\n          credit: amount\n        }\n      ]\n    }\n  }\n];\n"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                528,
                -192
            ],
