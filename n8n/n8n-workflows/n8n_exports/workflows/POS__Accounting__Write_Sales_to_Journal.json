                                   ],
                      "id":  "bc2b45a4-67d7-41f7-8751-307f9b5bb878",
                      "name":  "Schedule Trigger"
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "WITH next_event AS (\n    -- 1. Find the absolute next timestamp to process\n    SELECT MIN(created_at) as start_ts\n    FROM sales\n    WHERE created_at \u003e COALESCE(\n        (SELECT MAX(last_write) FROM journal_write_log), \n        \u00271900-01-01\u0027::timestamp\n    )\n),\ndaily_data AS (\n    -- 2. Grab all sales from that timestamp until the end of its specific day\n    SELECT \n        s.total_price,\n        s.quantity,\n        s.transaction_id,\n        (ne.start_ts)::DATE as day_label,\n        s.created_at\n    FROM sales s\n    JOIN next_event ne ON s.created_at \u003e= ne.start_ts\n    WHERE s.created_at \u003c (DATE_TRUNC(\u0027day\u0027, ne.start_ts) + INTERVAL \u00271 day\u0027)\n)\n-- 3. Aggregate into your requested JSON format\nSELECT json_build_object(\n    \u0027sales_date\u0027, day_label,\n    \u0027total_revenue\u0027, SUM(total_price),\n    \u0027total_items_sold\u0027, SUM(quantity),\n    \u0027total_transactions\u0027, COUNT(DISTINCT transaction_id),\n    \u0027source\u0027, \u0027POS_TERMINAL\u0027,\n    \u0027next_timestamp\u0027, MAX(created_at)\n) AS day_totals\nFROM daily_data\nGROUP BY day_label;\n",
                                         "options":  {

                                                     }
                                     },
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.6,
                      "position":  [
                                       -160,
                                       -192
                                   ],
                      "id":  "e178ac8f-d396-4f51-b9ad-a15322653d38",
                      "name":  "Execute a SQL query",
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "LleDUwLucS7vZHjv",
                                                           "name":  "POS DB Credentials"
                                                       }
                                      }
                  },
                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "SELECT json_object_agg(\u0027code_\u0027 || code, id) AS accounts\nFROM accounts\nWHERE code IN (\u00271000\u0027, \u00274000\u0027);\n",
                                         "options":  {

                                                     }
                                     },
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.6,
                      "position":  [
                                       288,
                                       -192
                                   ],
                      "id":  "3f2ed273-c03f-441b-893b-547efb9bba6a",
                      "name":  "Execute a SQL query1",
                      "credentials":  {
                                          "postgres":  {
                                                           "id":  "tdeYwbyCFeBuflzs",
                                                           "name":  "Accounting Db Credentials"
                                                       }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const accounts = $input.first().json.accounts;\nconst day_totals = $(\u0027Execute a SQL query\u0027).first().json.day_totals;\n\nconst amount = day_totals.total_revenue;\nconst date = day_totals.sales_date; // e.g., \"2026-02-08\"\nconst items = day_totals.total_items_sold;\nconst txns = day_totals.total_transactions;\n\nconst cash_account_id = accounts.code_1000;\nconst sales_account_id = accounts.code_4000;\n\n// Description with volume context\nconst description = `Sold: $${Number(amount).toLocaleString()} from ${items} items across ${txns} transactions.`;\n\n/** * Build reference using the sales_date.\n * We sanitize the date and add a mini-timestamp suffix \n * to keep it unique if the process runs multiple times.\n */\nconst datePart = date.replace(/-/g, \u0027\u0027); // \"20260208\"\nconst timePart = new Date().toLocaleTimeString(\u0027en-GB\u0027, { hour12: false }).replace(/:/g, \u0027\u0027).slice(0, 4); \nconst reference = `POS-${datePart}-${timePart}`;\n\nreturn [\n  {\n    json: {\n      date: date,\n      description: description,\n      reference: reference,\n      lines: [\n        {\n          account_id: cash_account_id,\n          debit: amount,\n          credit: 0\n        },\n        {\n          account_id: sales_account_id,\n          debit: 0,\n          credit: amount\n        }\n      ]\n    }\n  }\n];\n"
                                     },
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       528,
                                       -192
                                   ],
