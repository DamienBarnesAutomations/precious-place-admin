        {
            "parameters": {
                "operation": "executeQuery",
                "query": "-- Logic for Profit & Loss Aggregation\nSELECT \n    ac.type,\n    ac.name AS category_name,\n    ac.label AS category_label,\n    a.code,\n    a.name,\n    SUM(CASE \n        WHEN a.type = 'income' THEN (l.credit - l.debit)\n        WHEN a.type = 'expense' THEN (l.debit - l.credit)\n        ELSE 0 \n    END) as balance\nFROM accounts a\nJOIN account_categories ac ON a.category_id = ac.id\nLEFT JOIN journal_lines l ON a.id = l.account_id\nWHERE a.type IN ('income', 'expense')\nGROUP BY ac.type, ac.name, ac.label, a.code, a.name\nORDER BY a.code;\n",
                "options": {}
            },
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.6,
