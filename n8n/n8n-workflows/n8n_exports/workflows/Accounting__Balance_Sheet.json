        {
            "parameters": {
                "operation": "executeQuery",
                "query": "-- Logic for Balance Sheet Aggregation\nSELECT \n    ac.type,\n    ac.label AS category_label,\n    a.code,\n    a.name,\n    SUM(CASE \n        WHEN a.normal_balance = 'debit' THEN (l.debit - l.credit)\n        ELSE (l.credit - l.debit)\n    END) as balance\nFROM accounts a\nJOIN account_categories ac ON a.category_id = ac.id\nLEFT JOIN journal_lines l ON a.id = l.account_id\nWHERE a.type IN ('asset', 'liability', 'equity')\nGROUP BY ac.type, ac.label, a.code, a.name\nORDER BY a.code;\n",
                "options": {}
            },
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.6,
