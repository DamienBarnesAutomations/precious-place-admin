    "name": "Acccounting: Expense Report",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT \n    je.entry_date,\n    ac.label AS vendor, -- Using category label as the 'Vendor' group for your UI\n    je.description,\n    jl.debit AS amount,\n    je.reference\nFROM journal_lines jl\nJOIN journal_entries je ON jl.journal_entry_id = je.id\nJOIN accounts a ON jl.account_id = a.id\nJOIN account_categories ac ON a.category_id = ac.id\nWHERE a.type = 'expense'\n  AND jl.debit > 0\nORDER BY je.entry_date DESC, jl.created_at DESC;\n",
                "options": {}
            },
