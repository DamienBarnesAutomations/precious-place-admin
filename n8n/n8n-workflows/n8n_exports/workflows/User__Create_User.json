        {
            "parameters": {
                "jsCode": "const crypto = require('crypto');\nconst password = $input.first().json.password;\n\nif (!password) {\n  return [{ json: { error: 'No password provided' } }];\n}\n\n// Generate a random salt (like bcrypt.gensalt())\nconst salt = crypto.randomBytes(16).toString('hex');\n\n// Hash with scrypt (64-byte output, comparable security to bcrypt 12 rounds)\nconst hashed = crypto.scryptSync(password, salt, 64).toString('hex');\n\n// Store as \"salt:hash\" — matches your verify logic exactly\nreturn [{ json: { hashed_password: `${salt}:${hashed}` } }];"
            },
