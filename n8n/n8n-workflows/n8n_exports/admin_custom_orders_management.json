      "id": "respond-update",
      "name": "Respond Update"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst text = body.message;\nconst raw_message = text;\n\n// Regex for \"Date, Client Name, Client Phone, Note\"\n// Example: 15th March, Marinella, 4634945, 2-tier chocolate cake\nconst parts = text.split(',').map(p => p.trim());\n\nlet order_date = parts[0] || 'today';\nlet client_name = parts[1] || 'Unknown';\nlet client_phone = parts[2] || '';\nlet notes = parts.slice(3).join(', ') || text;\n\nreturn {\n  order_date,\n  client_name,\n  client_phone,\n  notes,\n  raw_message,\n  attachment_url: body.filename ? body.filename.replace('/home/node/.n8n-files/public/', '/images/') : null\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        400
      ],
      "id": "parse-logic",
      "name": "Parse Order"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO orders (order_date, client_name, client_phone, notes, attachment_url, raw_message) VALUES ($1, $2, $3, $4, $5, $6) RETURNING *;",
        "options": {
          "queryReplacement": "={{ [$json.order_date, $json.client_name, $json.client_phone, $json.notes, $json.attachment_url, $json.raw_message] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        400
      ],
      "id": "pg-insert",
      "name": "Insert Order",
      "credentials": {
        "postgres": {
          "id": "MBtoQsz0fuSb7cVd",
          "name": "Message Admin DB Credentials"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-response",
              "name": "response_message",
              "value": "=✅ *Cake Order Logged!*\\n\\n📅 **Date:** {{ $json.order_date }}\\n👤 **Client:** {{ $json.client_name }}\\n📝 **Notes:** {{ $json.notes }}\\n\\nView the full schedule at /orders/",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
