# Stage 1: Build
FROM node:20-alpine AS build-stage
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

ARG VITE_API_BASE_URL
ARG VITE_APP_TITLE
ARG VITE_GET_JOURNAL_ENTRIES_WEBHOOK
ARG VITE_GET_ACCOUNTS_WEBHOOK
ARG VITE_GET_GENERAL_LEDGER_WEBHOOK
ARG VITE_GET_TRIAL_BALANCE_WEBHOOK
ARG VITE_GET_CATEGORIES_WEBHOOK
ARG VITE_GET_BALANCE_SHEET_WEBHOOK
ARG VITE_GET_PROFIT_LOSS_WEBHOOK
ARG VITE_POST_JOURNAL_ENTRIES_WEBHOOK
ARG VITE_CREATE_ACCOUNT_WEBHOOK
ARG VITE_GET_INCOME_WEBHOOK
ARG VITE_GET_EXPENSE_WEBHOOK
ARG VITE_CREATE_ADMIN_USER_URL
ARG VITE_CREATE_CHAT_ADMIN_USER_URL

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_TITLE=$VITE_APP_TITLE
ENV VITE_GET_JOURNAL_ENTRIES_WEBHOOK=$VITE_GET_JOURNAL_ENTRIES_WEBHOOK
ENV VITE_GET_ACCOUNTS_WEBHOOK=$VITE_GET_ACCOUNTS_WEBHOOK
ENV VITE_GET_GENERAL_LEDGER_WEBHOOK=$VITE_GET_GENERAL_LEDGER_WEBHOOK
ENV VITE_GET_TRIAL_BALANCE_WEBHOOK=$VITE_GET_TRIAL_BALANCE_WEBHOOK
ENV VITE_GET_CATEGORIES_WEBHOOK=$VITE_GET_CATEGORIES_WEBHOOK
ENV VITE_GET_BALANCE_SHEET_WEBHOOK=$VITE_GET_BALANCE_SHEET_WEBHOOK
ENV VITE_GET_PROFIT_LOSS_WEBHOOK=$VITE_GET_PROFIT_LOSS_WEBHOOK
ENV VITE_POST_JOURNAL_ENTRIES_WEBHOOK=$VITE_POST_JOURNAL_ENTRIES_WEBHOOK
ENV VITE_CREATE_ACCOUNT_WEBHOOK=$VITE_CREATE_ACCOUNT_WEBHOOK
ENV VITE_GET_INCOME_WEBHOOK=$VITE_GET_INCOME_WEBHOOK
ENV VITE_GET_EXPENSE_WEBHOOK=$VITE_GET_EXPENSE_WEBHOOK
ENV VITE_CREATE_ADMIN_USER_URL=$VITE_CREATE_ADMIN_USER_URL
ENV VITE_CREATE_CHAT_ADMIN_USER_URL=$VITE_CREATE_CHAT_ADMIN_USER_URL

RUN npm run build

# Stage 2: Serve
FROM nginx:alpine
COPY --from=build-stage /app/dist /usr/share/nginx/html/accounting
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
